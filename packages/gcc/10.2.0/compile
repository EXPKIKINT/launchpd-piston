#!/usr/bin/env bash

# Put instructions to compile source code, remove this file if the language does not require this stage


case "${PISTON_LANGUAGE}" in
    c)
        rename 's/\.code$/\.c/' "$@"
        for f in "$@"; do
            if [ -f "$f" ] && [[ "$f" != *.* ]]; then
                mv "$f" "$f.c"
            fi
        done
        gcc -std=c11 *.c -lm
        ;;
    c++)
        rename 's/\.code$/\.cpp/' "$@"
        for f in "$@"; do
            if [ -f "$f" ] && [[ "$f" != *.* ]]; then
                mv "$f" "$f.cpp"
            fi
        done
        g++ -std=c++17 *.cpp
        ;;
    d)
        rename 's/\.code$/\.d/' "$@"
        gdc *.d
        ;;
    fortran)
        rename 's/\.code$/\.f90/' "$@"
        gfortran *.f90
        ;;
    *)
        echo "How did you get here? (${PISTON_LANGUAGE})"
        exit 1
        ;;
esac

chmod +x a.out